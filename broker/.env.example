# Usuarios del broker. Copia este archivo como .env (no se versiona) y completa las claves.

# Backend (adaptador MQTT): lee device/+/telemetria
MQTT_BACKEND_USUARIO=vitalify-backend
MQTT_BACKEND_CLAVE=<clave del backend>

# Wearables: "CODIGO:clave" separados por espacios. CODIGO es el del dispositivo en Vitalify
# (CODIGO_DISPOSITIVO en tesis/config.h) y la clave es MQTT_CLAVE de tesis/secretos.h.
# Solo letras y números en las claves.
MQTT_DISPOSITIVOS=ESP32-001:<clave del ESP32-001>
